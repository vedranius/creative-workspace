+async fn fetch_preview(path: &str) -> Result<egui::ColorImage, String> {
+    use wasm_bindgen_futures::JsFuture;
+    let response: web_sys::Response = JsFuture::from(web_sys::window().ok_or("missing window")?.fetch_with_str(path)).await.map_err(|e|format!("preview fetch: {e:?}"))?.dyn_into().map_err(|_|"invalid preview response")?;
+    if !response.ok() || response.headers().get("Content-Type").ok().flatten().as_deref() != Some("image/png") { return Err("Server PNG is unavailable".into()); }
+    let buffer = JsFuture::from(response.array_buffer().map_err(|e|format!("preview: {e:?}"))?).await.map_err(|e|format!("preview: {e:?}"))?;
+    let bytes = js_sys::Uint8Array::new(&buffer).to_vec();
+    if bytes.len() < 24 || bytes.len() > 12 * 1024 * 1024 || &bytes[..8] != b"\x89PNG\r\n\x1a\n" { return Err("Invalid bounded server PNG".into()); }
+    let w = u32::from_be_bytes(bytes[16..20].try_into().map_err(|_|"width")?) as usize;
+    let h = u32::from_be_bytes(bytes[20..24].try_into().map_err(|_|"height")?) as usize;
+    if w == 0 || h == 0 || w > 1280 || h > 1280 { return Err("Server PNG dimensions exceed the preview limit".into()); }
+    let png = image::load_from_memory_with_format(&bytes, image::ImageFormat::Png).map_err(|e|format!("Server PNG decoding failed: {e}"))?.to_rgba8();
+    if png.width() as usize != w || png.height() as usize != h { return Err("Server PNG dimensions do not agree".into()); }
+    Ok(egui::ColorImage::from_rgba_unmultiplied([w,h], png.as_raw()))
+}
