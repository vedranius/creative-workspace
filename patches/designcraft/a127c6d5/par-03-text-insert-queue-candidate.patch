+async fn post_json(path: &str, body: serde_json::Value) -> Result<serde_json::Value, String> {
+    use wasm_bindgen::JsValue;
+    use wasm_bindgen_futures::JsFuture;
+    let init = web_sys::RequestInit::new(); init.set_method("POST"); init.set_body(&JsValue::from_str(&body.to_string()));
+    let request = web_sys::Request::new_with_str_and_init(path, &init).map_err(|e|format!("request: {e:?}"))?;
+    request.headers().set("Content-Type","application/json").map_err(|e|format!("headers: {e:?}"))?;
+    let response: web_sys::Response = JsFuture::from(web_sys::window().ok_or("missing window")?.fetch_with_request(&request)).await.map_err(|e|format!("fetch: {e:?}"))?.dyn_into().map_err(|_|"invalid response")?;
+    let body = JsFuture::from(response.text().map_err(|e|format!("body: {e:?}"))?).await.map_err(|e|format!("body: {e:?}"))?.as_string().ok_or("response body was not text")?;
+    let value: serde_json::Value = serde_json::from_str(&body).map_err(|e|format!("decode JSON: {e}"))?;
+    if !response.ok() { return Err(value.get("error").and_then(serde_json::Value::as_str).unwrap_or("server request failed").to_owned()); }
+    Ok(value)
+}
