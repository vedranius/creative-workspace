+impl WebShell {
+    fn handle_endnote_query(&mut self, ctx: &egui::Context) {
+        let now = endnote_query_now();
+        let now = if now.is_finite() && now >= 0.0 { now as u64 } else { u64::MAX };
+        if let Some(stopped) = self.query_delivery.poll(&self.app, &self.session_id, now) {
+            abort_endnote_query(stopped.ticket.session(), stopped.ticket.request_id());
+            self.query_status = match stopped.reason {QueryStop::Deadline => "deadline", _ => "context-changed"}.into();
+            if stopped.reason == QueryStop::Deadline { self.app.status("Endnote query timed out; choose Edit Endnote again"); }
+        }
+        let replies = std::mem::take(&mut *self.query_replies.lock().unwrap_or_else(|e|e.into_inner()));
+        for (ticket,reply) in replies {
+            match self.query_delivery.deliver(&mut self.app, &self.session_id, &ticket, reply.as_ref().map_err(String::as_str), now) {
+                QueryDelivery::Ignored => {},
+                QueryDelivery::Stopped(stopped) => { abort_endnote_query(stopped.ticket.session(), stopped.ticket.request_id()); self.query_status = "context-changed".into(); },
+                QueryDelivery::Opened => { self.query_status = "opened".into(); ctx.request_repaint(); },
+                QueryDelivery::Failed | QueryDelivery::Rejected => { self.query_status = "failed".into(); self.app.status("Endnote query failed; choose Edit Endnote again"); },
+            }
+        }
+        if std::mem::take(&mut self.app.host_endnote_query_requested) {
+            match self.query_delivery.begin(&self.app, &self.session_id, now) {
+                Err(error) => self.app.status(error),
+                Ok((ticket,request)) => {
+                    // The original Quick Apply has closed. Its search field must not
+                    // keep keyboard focus during the asynchronous interval.
+                    if let Some(focused) = ctx.memory(|memory|memory.focused()) {
+                        ctx.memory_mut(|memory|memory.surrender_focus(focused));
+                    }
+                    self.query_status = "pending".into();
+                    self.app.status("Reading the selected Endnote; Escape cancels");
+                    let promise = fetch_endnote_query(ticket.session(), ticket.request_id(), &request.to_string());
+                    let replies = self.query_replies.clone(); let ctx = ctx.clone();
+                    wasm_bindgen_futures::spawn_local(async move {
+                        let reply = match wasm_bindgen_futures::JsFuture::from(promise).await {
+                            Ok(value) => value.as_string().ok_or_else(||"Invalid Endnote query response".to_owned())
+                                .and_then(|text|serde_json::from_str(&text).map_err(|_|"Invalid Endnote query JSON".into())),
+                            Err(_) => Err("Endnote query transport failed".into()),
+                        };
+                        replies.lock().unwrap_or_else(|e|e.into_inner()).push((ticket,reply));ctx.request_repaint();
+                    });
+                }
+            }
+        }
+        if self.query_delivery.pending_ticket().is_some() { ctx.request_repaint_after(std::time::Duration::from_millis(50)); }
+    }
