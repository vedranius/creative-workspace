new file mode 100644
index 0000000000000000000000000000000000000000..4678a54df8d33f305073150a3095fb5f6801da28
--- /dev/null
+++ b/apps/designcraft-web/file-provider.js
@@ -0,0 +1,57 @@
+// The upstream Open action remains the caller; this host service browses only the
+// explicitly connected DesignCraft share and returns a provider-relative path.
+export function chooseAndCopyNativeDocument(_sessionId, shareId) {
+  return new Promise((resolve, reject) => {
+    const dialog = document.createElement("dialog");
+    dialog.setAttribute("aria-label", "Open a DesignCraft publication");
+    dialog.style.cssText = "width:min(38rem,90vw);max-height:80vh;border:1px solid #667085;border-radius:12px;background:#20242b;color:#f5f7fa;padding:1rem";
+    const title = document.createElement("h2"); title.textContent = "Open a publication from the connected folder";
+    const location = document.createElement("p"), list = document.createElement("div"), status = document.createElement("p");
+    const up = document.createElement("button"); up.type = "button"; up.textContent = "Parent folder";
+    const upload = document.createElement("button"); upload.type = "button"; upload.textContent = "Copy a local file into the server workspace…";
+    const input = document.createElement("input"); input.type = "file"; input.accept = ".designcraft"; input.hidden = true;
+    dialog.append(title, upload, input, location, up, list, status); document.body.append(dialog);
+    let folder = "", settled = false;
+    const finish = (error, value = null) => { if (settled) return; settled = true; dialog.close(); dialog.remove(); error ? reject(String(error)) : resolve(value); };
+    dialog.addEventListener("cancel", () => finish(null), {once:true});
+    upload.onclick = () => input.click();
+    input.oncancel = () => finish(null);
+    input.onchange = async () => {
+      const file = input.files?.[0]; if (!file) { finish(null); return; }
+      try {
+        if (!/\.designcraft$/i.test(file.name) || file.name.length > 255 || /[\\/\x00]/.test(file.name)) throw new Error("Choose a native .designcraft publication");
+        if (file.size > 64 * 1024 * 1024) throw new Error("Publication exceeds the 64 MB limit");
+        const path = `imports/${crypto.randomUUID()}/${file.name}`;
+        const response = await fetch(`/api/designcraft/sessions/${encodeURIComponent(_sessionId)}/input?destination=server&path=${encodeURIComponent(path)}`, {method:"PUT",credentials:"same-origin",headers:{"Content-Type":"application/octet-stream"},body:file});
+        const receipt = await response.json();
+        if (!response.ok || receipt.mode !== "copy-first" || receipt.sessionId !== _sessionId || receipt.path !== path || receipt.bytes !== file.size) throw new Error(receipt.error || "Server did not acknowledge the selected file copy");
+        finish(null,path);
+      } catch (error) { status.textContent = error.message || String(error); }
+    };
+    up.onclick = () => { folder = folder.split("/").slice(0,-1).join("/"); load().catch(error => status.textContent = error.message); };
+    async function load() {
+      location.textContent = `/${folder}`; up.disabled = !folder; list.replaceChildren(); status.textContent = "Loading selected folder…";
+      const query = new URLSearchParams({app:"designcraft",path:folder});
+      const response = await fetch(`/api/storage/shares/${encodeURIComponent(shareId)}/files?${query}`, {credentials:"same-origin"});
+      const result = await response.json(); if (!response.ok) throw new Error(result.error || `Folder unavailable: HTTP ${response.status}`);
+      for (const entry of result.entries) if (entry.directory || /\.designcraft$/i.test(entry.name)) {
+        const button = document.createElement("button"); button.type = "button"; button.textContent = `${entry.directory ? "▤" : "◇"} ${entry.name}`;
+        button.style.cssText = "display:block;width:100%;text-align:left;margin:.35rem 0;padding:.55rem";
+        button.onclick = () => { const path = [folder,entry.name].filter(Boolean).join("/"); if (entry.directory) { folder = path; load().catch(error => status.textContent = error.message); } else finish(null,path); };
+        list.append(button);
+      }
+      status.textContent = list.childElementCount ? "Choose a document. It opens through the connected on-demand provider." : "No native DesignCraft documents in this folder.";
+    }
+    dialog.showModal(); load().catch(error => status.textContent = error.message);
+  });
+}
+
+// Reuse the workspace common folder chooser. The original DesignApp remains the editor.
+export async function chooseDesignCraftProvider() {
+  const {chooseLocalFolder} = await import("/storage/folders.js");
+  return await new Promise((resolve,reject) => chooseLocalFolder({
+    app:"designcraft", requireWriteAccess:true, chooseDestination:false, allowedModes:["ondemand"],
+    onReady:share => resolve(share.id), onCancel:() => reject(new Error("Choose a connected DesignCraft folder to continue")),
+    onStatus:message => { const status=document.getElementById("designcraft_loading"); if(status) status.textContent=message; },
+  }).catch(reject));
+}
