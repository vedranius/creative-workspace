+fn server_mirror_stages_frame_creation_without_local_mutation() {
+    let mut s = Session::new();
+    s.set_server_mirror();
+    let doc = designcraft_doc::Document::new(&designcraft_doc::build::NewDocument::default());
+    s.add_document(DocState::new(doc, None));
+    let before = s.active().unwrap().doc.clone();
+    let params = json!({"spread":{"index":0},"shape":"rectangle","content":"graphic","rect":[10.0,20.0,100.0,120.0]});
+    assert!(s.execute("frame.create", &params).is_ok());
+    assert!(std::sync::Arc::ptr_eq(&before, &s.active().unwrap().doc));
+    assert_eq!(s.take_host_action(), Some(("frame.create".into(), params)));
+    assert!(s.execute("object.fill", &json!({"swatch":"[Black]"})).is_err());
+    assert!(s.take_host_action().is_none());
+}
