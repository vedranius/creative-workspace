+/// One acknowledged page display, shared by the server PNG and original tool input.
+/// Tool events still use the original multi-spread CanvasLayout coordinates.
+#[derive(Clone, Copy)]
+struct HostPageView {
+    display: Rect,
+    page_bounds: DRect,
+    spread_to_canvas: Affine,
+}
+
+impl HostPageView {
+    fn new(screen: Rect, pixels: egui::Vec2, page_bounds: DRect, spread_to_canvas: Affine) -> Option<Self> {
+        if pixels.x <= 0.0 || pixels.y <= 0.0 || !pixels.is_finite()
+            || page_bounds.width() <= 0.0 || page_bounds.height() <= 0.0
+        { return None; }
+        let scale = ((screen.width() - 40.0) / pixels.x).min((screen.height() - 40.0) / pixels.y).max(0.01);
+        Some(Self { display: Rect::from_center_size(screen.center(), pixels * scale), page_bounds, spread_to_canvas })
+    }
+
+    fn to_canvas(self, screen: Pos2) -> Point {
+        let point = Point::new(
+            self.page_bounds.x0 + (screen.x - self.display.min.x) as f64 / self.display.width() as f64 * self.page_bounds.width(),
+            self.page_bounds.y0 + (screen.y - self.display.min.y) as f64 / self.display.height() as f64 * self.page_bounds.height(),
+        );
+        self.spread_to_canvas * point
+    }
+
+    fn spread_to_screen(self, point: [f64; 2]) -> Pos2 {
+        pos2(self.display.min.x + ((point[0] - self.page_bounds.x0) / self.page_bounds.width()) as f32 * self.display.width(),
+             self.display.min.y + ((point[1] - self.page_bounds.y0) / self.page_bounds.height()) as f32 * self.display.height())
+    }
+
