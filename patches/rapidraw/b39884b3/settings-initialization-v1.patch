+// Shared by the original initialization hook and the isolated browser preference composition.
+// Loading supplies in-memory legacy defaults; it never writes or replaces an intentional None.
+export async function loadInitialSettings({ supportedAdjustments, isCurrent = () => true }: {
+  supportedAdjustments?: string[]; isCurrent?: () => boolean;
+} = {}) {
+  const settings: any = await invoke(Invokes.LoadSettings);
+  if (!isCurrent()) throw new Error('Newer settings superseded initialization');
+  const copy = settings.copyPasteSettings;
+  const keys = supportedAdjustments ?? COPYABLE_ADJUSTMENT_KEYS;
+  if (!copy || !Array.isArray(copy.includedAdjustments)) {
+    settings.copyPasteSettings = {
+      ...copy, mode: copy?.mode ?? 'merge', includedAdjustments: [...keys],
+      knownAdjustments: copy?.knownAdjustments ?? [...keys], autoSync: copy?.autoSync ?? false,
+    };
+  }
+  if (supportedAdjustments) {
+    const prefs = settings.copyPasteSettings;
+    if (!['merge', 'replace'].includes(prefs.mode) || prefs.autoSync !== false) throw new Error('Unsupported browser copy/paste preferences');
+    for (const values of [prefs.includedAdjustments, prefs.knownAdjustments]) {
+      if (!Array.isArray(values) || new Set(values).size !== values.length || values.some(key => !keys.includes(key))) throw new Error('Unsupported browser adjustment key');
+    }
+  }
+  return settings;
+}
 
